# Clover REST Pay Display (US Flex / Cloud Pay Display)
CLOVER_ENV=sandbox
# CLOVER_CONNECT_BASE_URL=https://apisandbox.dev.clover.com/connect/v1
# CLOVER_OAUTH_BASE_URL=https://apisandbox.dev.clover.com
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_RAID=
CLOVER_POS_ID=LOWKIA-ADMIN
# Prefer a dedicated secret; falls back to JWT_SECRET
CLOVER_TOKEN_SECRET=
# Allow company owners to paste OAuth access tokens (sandbox / early prod)
CLOVER_ALLOW_MANUAL_TOKENS=1
